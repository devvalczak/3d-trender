# Skopiuj do .env i uzupełnij klucze. Źródła bez kluczy są pomijane.
# DEMO_MODE: auto = dane demo tylko tam, gdzie brak skonfigurowanego źródła; on = zawsze demo; off = nigdy
DEMO_MODE=auto

# --- Rynki / konkurencja ---
# Allegro: https://apps.developer.allegro.pl/ (typ aplikacji: "działa bez użytkownika", client_credentials)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_SANDBOX=false
# eBay: https://developer.ebay.com/my/keys (Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE
# Etsy: https://www.etsy.com/developers/your-apps (keystring + shared secret)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# OLX: publiczne wyszukiwanie, bez klucza
OLX_ENABLED=true

# --- Trendy ---
# SerpApi (Google Trends, stabilne, darmowy limit miesięczny): https://serpapi.com/
SERPAPI_KEY=
# pytrends (nieoficjalne, bez klucza, wymaga: pip install ".[pytrends]")
PYTRENDS_ENABLED=true
TRENDS_GEO=PL

# --- Modele 3D ---
# Thingiverse: https://www.thingiverse.com/developers (App Token)
THINGIVERSE_TOKEN=
# Cults3D: https://cults3d.com/en/api/keys
CULTS3D_USERNAME=
CULTS3D_API_KEY=
# MyMiniFactory: https://www.myminifactory.com/settings/developer
MYMINIFACTORY_API_KEY=
# Printables: nieoficjalne API GraphQL, bez klucza
PRINTABLES_ENABLED=true

# --- Aplikacja ---
DB_PATH=data/trender.db
REFRESH_INTERVAL_HOURS=24
MARKET_CACHE_HOURS=6
HOST=127.0.0.1
PORT=8000
